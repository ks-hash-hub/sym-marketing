# Symphonic Marketing Dashboard — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to git.

# Airtable personal access token (read scope required: data.records:read)
# Create one at: https://airtable.com/create/tokens
VITE_AIRTABLE_TOKEN=your_airtable_token_here

# Airtable base ID (default is already set in src/api/airtable.js)
# Override here only if you want to point to a different base.
# VITE_AIRTABLE_BASE=apppQyOGTr6uGeYZd

# Chartmetric refresh token — enables live Spotify ML + social follower enrichment
# Get yours from: https://chartmetric.com/api
VITE_CHARTMETRIC_TOKEN=your_chartmetric_refresh_token_here
